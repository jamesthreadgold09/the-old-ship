---
// Drinks: free house, rotating local ales, and wine. Kept light.
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import alesImg from '../assets/photos/drinks-ales.jpg';
import tapsImg from '../assets/photos/drinks-taps.jpg';

// Local Chilterns/Thames-valley breweries. Owner: add or swap to match what you
// actually rotate through (keep them genuinely local to fit the "doorstep" line).
const breweries = ['Rebellion', 'Chiltern', 'Loddon'];
---

<section id="drinks" class="bg-white px-5 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      {/* Two photos as one flush frame: cask ales on top, tap font below */}
      <div data-reveal class="mx-auto w-full max-w-md overflow-hidden rounded-2xl shadow-soft ring-1 ring-navy/10 lg:order-last">
        <Image
          src={alesImg}
          alt="Three cask hand pumps at The Old Ship with clips for Rebellion Zebedee, Fuller's London Pride and Loddon Hoppit"
          widths={[420, 660, 900]}
          sizes="(min-width: 1024px) 448px, 100vw"
          loading="lazy"
          class="h-60 w-full object-cover object-[center_62%] transition duration-500 motion-safe:hover:scale-[1.03] sm:h-64"
        />
        <Image
          src={tapsImg}
          alt="The Old Ship's tap font pouring Renegade lager, Kicking Goat cider, a session IPA, Carlsberg and Guinness"
          widths={[420, 660, 900]}
          sizes="(min-width: 1024px) 448px, 100vw"
          loading="lazy"
          class="h-60 w-full object-cover object-center transition duration-500 motion-safe:hover:scale-[1.03] sm:h-64"
        />
      </div>

      <div>
        <SectionHeader eyebrow="Free house" title="Drinks" align="left">
          {/* tankard */}
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 3h12l-1.2 12.5a3 3 0 0 1-3 2.7h-3.6a3 3 0 0 1-3-2.7L6 3zM6.4 7h11.2M11 18.5V21m-2.5 0h5" />
          </svg>
        </SectionHeader>
        <div data-reveal class="mt-6 space-y-5 text-lg leading-relaxed text-ink/80">
          <p>
            Three hand pumps, always rotating, mostly from breweries close to home. As a free house we
            change what's on regularly, so there's usually something new to try.
          </p>
          <p>
            On tap you'll also find a couple of lagers and a cider, plus a proper pint of Guinness.
          </p>
          <p>
            Not one for ale? We've a well-chosen wine list of reds, whites, rosé and Prosecco, alongside
            the usual spirits and soft drinks.
          </p>
        </div>

        <p data-reveal class="mt-7 text-xs font-medium uppercase tracking-[0.28em] text-ink/75">
          Often on our doorstep
        </p>
        <ul data-reveal class="mt-3 flex flex-wrap gap-2">
          {
            breweries.map((b) => (
              <li class="rounded-full border border-navy/20 bg-mist px-4 py-1.5 text-sm font-medium text-navy">
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
