---
// Drinks (brief §4.4, copy §11) — free house, rotating local ales, wine. Light.
import { Image } from 'astro:assets';
import drinksImg from '../assets/photos/drinks-pumps.jpg';

const breweries = ['Rebellion', 'Chiltern', 'Loddon', 'Ossett'];
---

<section id="drinks" class="bg-white px-5 py-20 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Portrait image -->
      <Image
        src={drinksImg}
        alt="The Old Ship's brass bar top with a row of rotating hand pumps and colourful pump clips"
        widths={[420, 660, 900]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        loading="lazy"
        class="mx-auto w-full max-w-md rounded-2xl object-cover shadow-lg shadow-navy/10 ring-1 ring-navy/10 lg:order-last"
      />

      <div>
        <span class="text-xs font-medium uppercase tracking-[0.28em] text-navy">Free house</span>
        <h2 class="mt-3 font-serif text-4xl font-semibold text-ink sm:text-5xl">Drinks</h2>
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink/80">
          <p>
            Three hand pumps, always rotating, mostly from breweries close to home. As a free house we
            change what's on regularly, so there's usually something new to try.
          </p>
          <p>
            Not one for ale? We've a well-chosen wine list — reds, whites, rosé and Prosecco — alongside
            the usual spirits and soft drinks.
          </p>
        </div>

        <p class="mt-7 text-xs font-medium uppercase tracking-[0.28em] text-ink/50">
          Often on our doorstep
        </p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            breweries.map((b) => (
              <li class="rounded-full border border-navy/20 bg-mist px-4 py-1.5 text-sm font-medium text-navy">
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
