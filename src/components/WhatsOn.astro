---
// What's On: news and events live on Facebook. We link out with a
// "Follow us on Facebook" button rather than embedding the live feed, so it
// works for every visitor (many browsers block Facebook's embed) with no
// cookies. Sits on a navy dashed-texture band for contrast.
import SectionHeader from './SectionHeader.astro';
import { FACEBOOK_URL, PHONE_HREF, PHONE_DISPLAY } from '../lib/site';
---

<section id="whats-on" class="dash-texture relative isolate bg-navy-deep px-5 py-20 text-center sm:px-6 sm:py-24">
  <div class="mx-auto max-w-2xl">
    <SectionHeader eyebrow="Stay in the loop" title="What's On" tone="dark">
      {/* star icon */}
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4l1.8 3.9 4.2.5-3.1 2.9.8 4.2L12 13.9 8.3 15.5l.8-4.2L6 8.4l4.2-.5L12 4z" />
      </svg>
    </SectionHeader>

    <p data-reveal class="mt-6 text-lg leading-relaxed text-white/85">
      There's always the Friday fish and chips and the Sunday roast, with sport on the big screen and
      the odd get-together in between. Whatever's coming up goes on Facebook first, so give us a follow
      to keep in the loop.
    </p>

    <a
      data-reveal
      href={FACEBOOK_URL}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-flex items-center justify-center gap-3 rounded-full border-t-2 border-gold bg-white px-7 py-3.5 text-base font-semibold text-navy shadow-soft transition hover:bg-mist motion-safe:hover:-translate-y-0.5"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z" />
      </svg>
      Follow us on Facebook
    </a>

    <p data-reveal class="mt-6 text-sm text-white/80">
      Planning a celebration or a get-together? Give us a ring on
      <a href={PHONE_HREF} class="link-gold font-medium text-gold-light hover:text-white">{PHONE_DISPLAY}</a>.
    </p>
  </div>
</section>
