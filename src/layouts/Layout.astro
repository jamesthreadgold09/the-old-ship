---
import '../styles/global.css';
import StructuredData from '../components/StructuredData.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import { absoluteUrl, siteRoot, ALLOW_INDEX } from '../lib/urls';
import { BUSINESS_NAME } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The Old Ship | Village pub & free house, Cadmore End',
  description = 'A proper village free house in the Buckinghamshire hills, serving honest food and well-kept ale since 1637. Marlow Road, Cadmore End. Book by phone.',
} = Astro.props;

// Public assets live at the site base (which may be a GitHub Pages subpath).
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;

// Absolute URLs derive from Astro.site + BASE_URL so they flip with the domain.
const canonical = siteRoot(Astro.site).href;
const ogImage = absoluteUrl('og-image.jpg', Astro.site);
const ogImageAlt = 'The Old Ship, a whitewashed 17th-century village free house in Cadmore End';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b3a5b" />
    {/* Enable motion only when JS runs, set before first paint so scroll-reveal
        elements are hidden without a flash. JS-off visitors keep static content. */}
    <script is:inline>document.documentElement.classList.add('motion');</script>
    {/* Hold indexing until the site is on its real domain (set PUBLIC_ALLOW_INDEX=true to allow). */}
    {!ALLOW_INDEX && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical} />

    {/* Icons */}
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/site.webmanifest`} />

    <title>{title}</title>

    {/* Open Graph: makes shared links (Facebook/WhatsApp/iMessage) render a rich card. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Twitter/X card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <StructuredData />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <ScrollMotion />
  </body>
</html>
