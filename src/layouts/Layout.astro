---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The Old Ship | Serving Cadmore End since 1637',
  description = 'A proper village free house in the Buckinghamshire hills. An inn on this spot since 1637, serving honest food, well-kept ale and good company. Marlow Road, Cadmore End.',
} = Astro.props;

// Public assets live at the site base (which may be a GitHub Pages subpath).
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b3a5b" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
    {/* Open Graph/Twitter meta and JSON-LD BarOrPub schema are not built yet. */}
  </head>
  <body>
    <slot />
  </body>
</html>
